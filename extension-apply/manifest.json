{
  "manifest_version": 3,
  "name": "PVAPINS Apply (User)",
  "version": "0.4.1",
  "description": "Sign in as a user and apply the Grammarly session assigned by the admin.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Apply assigned session"
  },
  "permissions": ["alarms", "cookies", "scripting", "tabs", "storage", "downloads"],
  "host_permissions": [
    "*://*.grammarly.com/*",
    "*://grammarly.com/*",
    "http://localhost:3000/*",
    "https://*.vercel.app/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*",
    "*://*.pvapins.com/*",
    "*://pvapins.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "incognito": "split"
}
